
using System;
using System.IO;
using System.Collections.Generic;
using System.Linq;
using System.Runtime.InteropServices;
using Inventor;
using Excel = Microsoft.Office.Interop.Excel;

namespace InventorModelStateCleanup
{
    class Program
    {
        // ============================================================
        // BLOCK 1: FOLDER CONFIGURATION
        // ============================================================

        static readonly string InputFolder =
            @"C:\Bharat_H_S\Nikhil\Task";

        static readonly string OutputFolder =
            @"C:\Bharat_H_S\Nikhil\Task\Output";


        static void Main(string[] args)
        {
            Inventor.Application inventor = null;

            try
            {
                // ====================================================
                // BLOCK 2: SELECT EXCEL FILE
                // ====================================================

                Console.WriteLine("MODEL STATE CLEANUP");
                Console.WriteLine("-------------------");
                Console.Write("Enter the full path of the Excel file: ");

                string excelPath = Console.ReadLine();

                if (string.IsNullOrWhiteSpace(excelPath) ||
                    !File.Exists(excelPath))
                {
                    Console.WriteLine("Excel file not found.");
                    return;
                }

                if (!Directory.Exists(InputFolder))
                {
                    Console.WriteLine("Input folder not found.");
                    return;
                }

                Directory.CreateDirectory(OutputFolder);

                // ====================================================
                // BLOCK 3: READ REQUIRED MODEL STATE NAMES
                // Reads names from column A of the first worksheet.
                // ====================================================

                List<string> requiredStates =
                    ReadModelStateNames(excelPath);

                if (requiredStates.Count == 0)
                {
                    Console.WriteLine(
                        "No Model State names found in Excel.");
                    return;
                }

                // ====================================================
                // BLOCK 4: CONNECT TO INVENTOR
                // Inventor must already be running.
                // ====================================================

                inventor = (Inventor.Application)
                    Marshal.GetActiveObject("Inventor.Application");

                // ====================================================
                // BLOCK 5: FIND INPUT IPT FILES
                // Excludes files inside the Output subfolder.
                // ====================================================

                string[] inputFiles = Directory.GetFiles(
                    InputFolder, "*.ipt", SearchOption.TopDirectoryOnly);

                // ====================================================
                // BLOCK 6: PROCESS EACH REQUESTED MODEL STATE
                // ====================================================

                foreach (string stateName in requiredStates)
                {
                    Console.WriteLine();
                    Console.WriteLine("Requested state: " + stateName);

                    string sourcePath = null;

                    foreach (string filePath in inputFiles)
                    {
                        Document searchDoc = null;

                        try
                        {
                            searchDoc = inventor.Documents.Open(
                                filePath, false);

                            PartDocument searchPart =
                                searchDoc as PartDocument;

                            if (searchPart == null)
                                continue;

                            ModelStates states =
                                searchPart.ComponentDefinition.ModelStates;

                            bool found = false;

                            for (int i = 1; i <= states.Count; i++)
                            {
                                if (string.Equals(
                                    states[i].Name,
                                    stateName,
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    found = true;
                                    break;
                                }
                            }

                            if (found)
                            {
                                sourcePath = filePath;
                                searchDoc.Close(true);
                                searchDoc = null;
                                break;
                            }
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine(
                                "Could not inspect " +
                                Path.GetFileName(filePath) + ": " +
                                ex.Message);
                        }
                        finally
                        {
                            if (searchDoc != null)
                            {
                                try { searchDoc.Close(true); } catch { }
                            }
                        }
                    }

                    if (sourcePath == null)
                    {
                        Console.WriteLine(
                            "SKIPPED: Model State not found.");
                        continue;
                    }

                    // =================================================
                    // BLOCK 7: CREATE OUTPUT FILE
                    // Filename is based on the requested Model State.
                    // =================================================

                    string outputPath = Path.Combine(
                        OutputFolder, stateName + ".ipt");

                    try
                    {
                        if (File.Exists(outputPath))
                        {
                            Console.WriteLine(
                                "SKIPPED: Output already exists: " +
                                outputPath);
                            continue;
                        }

                        File.Copy(sourcePath, outputPath, false);

                        // =================================================
                        // BLOCK 8: OPEN THE OUTPUT COPY
                        // =================================================

                        Document doc = null;

                        try
                        {
                            doc = inventor.Documents.Open(
                                outputPath, false);

                            PartDocument part = doc as PartDocument;

                            if (part == null)
                                throw new Exception(
                                    "Output is not an Inventor part.");

                            ModelStates states =
                                part.ComponentDefinition.ModelStates;

                            bool hasPrimary = false;
                            bool hasRequested = false;

                            for (int i = 1; i <= states.Count; i++)
                            {
                                string name = states[i].Name;

                                if (string.Equals(
                                    name, "Primary",
                                    StringComparison.OrdinalIgnoreCase))
                                    hasPrimary = true;

                                if (string.Equals(
                                    name, stateName,
                                    StringComparison.OrdinalIgnoreCase))
                                    hasRequested = true;
                            }

                            if (!hasPrimary || !hasRequested)
                            {
                                throw new Exception(
                                    "Primary or requested Model State missing.");
                            }

                            // =================================================
                            // BLOCK 9: ACTIVATE PRIMARY
                            // =================================================

                            for (int i = 1; i <= states.Count; i++)
                            {
                                if (string.Equals(
                                    states[i].Name, "Primary",
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    states[i].Activate();
                                    break;
                                }
                            }

                            // =================================================
                            // BLOCK 10: KEEP PRIMARY + REQUESTED STATE
                            // Delete all other Model States.
                            // =================================================

                            for (int i = states.Count; i >= 1; i--)
                            {
                                string currentName = states[i].Name;

                                bool keepPrimary = string.Equals(
                                    currentName, "Primary",
                                    StringComparison.OrdinalIgnoreCase);

                                bool keepRequested = string.Equals(
                                    currentName, stateName,
                                    StringComparison.OrdinalIgnoreCase);

                                if (!keepPrimary && !keepRequested)
                                {
                                    Console.WriteLine(
                                        "Deleting: " + currentName);

                                    states[i].Delete();
                                }
                            }

                            // =================================================
                            // BLOCK 11: SAVE CLEANED IPT FILE
                            // =================================================

                            part.Update2(true);
                            doc.Save();

                            Console.WriteLine(
                                "Saved: " + outputPath);
                        }
                        finally
                        {
                            if (doc != null)
                            {
                                try { doc.Close(true); } catch { }
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine(
                            "FAILED: " + stateName + " - " + ex.Message);
                    }
                }

                // ====================================================
                // BLOCK 12: FINISH
                // ====================================================

                Console.WriteLine();
                Console.WriteLine("Processing completed.");
                Console.WriteLine("Output folder: " + OutputFolder);
            }
            catch (Exception ex)
            {
                Console.WriteLine("ERROR: " + ex.Message);
            }

            Console.WriteLine("Press Enter to exit.");
            Console.ReadLine();
        }


        // ============================================================
        // BLOCK 13: EXCEL READER
        // Reads non-empty names from column A, first worksheet.
        // ============================================================

        static List<string> ReadModelStateNames(string excelPath)
        {
            List<string> names = new List<string>();

            Excel.Application excelApp = null;
            Excel.Workbook workbook = null;
            Excel.Worksheet worksheet = null;
            Excel.Range usedRange = null;

            try
            {
                excelApp = new Excel.Application();
                excelApp.Visible = false;
                excelApp.DisplayAlerts = false;

                workbook = excelApp.Workbooks.Open(excelPath);
                worksheet = (Excel.Worksheet)workbook.Worksheets[1];
                usedRange = worksheet.UsedRange;

                int rows = usedRange.Rows.Count;

                for (int row = 1; row <= rows; row++)
                {
                    Excel.Range cell = null;

                    try
                    {
                        cell = (Excel.Range)usedRange.Cells[row, 1];

                        string value = Convert.ToString(cell.Value2);

                        if (string.IsNullOrWhiteSpace(value))
                            continue;

                        value = value.Trim();

                        if (string.Equals(
                            value, "Model State",
                            StringComparison.OrdinalIgnoreCase) ||
                            string.Equals(
                            value, "Model State Name",
                            StringComparison.OrdinalIgnoreCase))
                            continue;

                        if (!names.Contains(
                            value, StringComparer.OrdinalIgnoreCase))
                        {
                            names.Add(value);
                        }
                    }
                    finally
                    {
                        if (cell != null)
                            Marshal.ReleaseComObject(cell);
                    }
                }
            }
            finally
            {
                if (workbook != null)
                {
                    try { workbook.Close(false); } catch { }
                }

                if (excelApp != null)
                {
                    try { excelApp.Quit(); } catch { }
                }

                ReleaseComObject(usedRange);
                ReleaseComObject(worksheet);
                ReleaseComObject(workbook);

                if (excelApp != null)
                    ReleaseComObject(excelApp);
            }

            return names;
        }


        // ============================================================
        // BLOCK 14: RELEASE EXCEL COM OBJECTS
        // ============================================================

        static void ReleaseComObject(object obj)
        {
            if (obj != null && Marshal.IsComObject(obj))
            {
                try { Marshal.ReleaseComObject(obj); }
                catch { }
            }
        }
    }
}
